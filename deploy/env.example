# Domain that points at this server (A record). Caddy fetches the TLS cert for it.
API_DOMAIN=api.example.com

# Origins allowed to call the API from a browser: your Vercel site, comma-separated.
# For the anonymous cookie session to work, the site and API should share a parent
# domain (e.g. example.com + api.example.com). See docs/deploy.md.
CORS_ORIGINS=https://example.com,https://www.example.com

# Operator key for the console's admin commands. Generate with:
#   openssl rand -base64 24 | tr '+/' '-_'
NIGHTSHIFT_ADMIN_KEY=change-me

# Optional
# EXTERNAL_ENABLED=false
# INFER_RPM=20
# LOG_LEVEL=info
